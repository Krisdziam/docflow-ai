# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=uk
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=10

# Supabase (add real values only to .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=documents

# n8n
N8N_WEBHOOK_URL=https://your-n8n.example/webhook/docflow
N8N_WEBHOOK_SECRET=replace_with_a_random_secret

# AI provider: decide before Milestone 2
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key

# Optional integrations. Do not enable without explicit approval.
GMAIL_INTAKE_ENABLED=false
NOTIFICATIONS_ENABLED=false
